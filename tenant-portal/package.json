{
  "name": "pragmatic-tenant-portal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compile:mu": "node scripts/compile-mu.mjs",
    "dev": "npm run compile:mu && vite",
    "build": "npm run compile:mu && vite build",
    "typecheck": "npm run compile:mu && tsc --noEmit",
    "test": "npm run compile:mu && tsx --test \"src/**/tests/*.test.ts\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@pragmatic-tech-ai/mural": "^0.67.2",
    "@pragmatic-tech-ai/pragmatic-app-shell": "^0.18.0",
    "@pragmatic-tech-ai/todl-runtime": "^0.7.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "ws": "^8.18.0"
  }
}
