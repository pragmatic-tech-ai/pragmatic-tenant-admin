{
  "name": "@pragmatic-tech-ai/pragmatic-tenant-admin",
  "version": "0.1.11",
  "private": true,
  "description": "The tenant admin console (pragmatic-tenant-admind): the console that ships into a client hive, with its tenant portal.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/pragmatic-tech-ai/pragmatic-tenant-admin.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "bin": {
    "pragmatic-tenant-admind": "dist/bin/pragmatic-tenant-admind.js",
    "pragmatic-tenant-admin-import": "dist/bin/pragmatic-tenant-admin-import.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test \"src/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json"
  },
  "dependencies": {
    "@pragmatic-tech-ai/mural": "^0.67.2",
    "@pragmatic-tech-ai/pragmatic-app-host": "^0.21.2",
    "@pragmatic-tech-ai/pragmatic-component": "^0.21.2",
    "@pragmatic-tech-ai/pragmatic-configuration": "^0.21.2",
    "@pragmatic-tech-ai/pragmatic-kube": "^0.21.2",
    "@pragmatic-tech-ai/pragmatic-realm-adapters": "^0.21.2",
    "@pragmatic-tech-ai/pragmatic-realm-custom": "^0.21.2",
    "@pragmatic-tech-ai/pragmatic-release-toolkit": "^0.21.2",
    "@pragmatic-tech-ai/pragmatic-tenant-plane": "^0.21.2",
    "@pragmatic-tech-ai/todl": "^0.66.5",
    "@pragmatic-tech-ai/todl-runtime": "^0.7.1"
  },
  "devDependencies": {
    "@pragmatic-tech-ai/pragmatic-identity-source-oidc": "^0.21.2",
    "@types/node": "^22.20.1",
    "@types/ws": "^8.5.10",
    "pg-mem": "^3.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "ws": "^8.18.0"
  },
  "pragmaticClosureCheck": {
    "Manifest": "closure.json",
    "Dockerfile": "Dockerfile",
    "Apps": [
      "pragmatic-tenant-admin"
    ]
  },
  "pragmaticContainerTemplate": {
    "App": "pragmatic-tenant-admin",
    "Entry": "src/bin/pragmatic-tenant-admind.ts",
    "UiDirs": [
      "tenant-portal"
    ]
  }
}
